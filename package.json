{
  "name": "gm-fabric-dashboard",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.5.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.22.3",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "color": "^5.0.3",
    "dygraphs": "~2.2.1",
    "js-quantities": "^1.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.3",
    "react-intl": "^10.1.18",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "react-select": "^5.10.2",
    "react-toastify": "^11.1.0",
    "redux": "^5.0.1",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/dygraphs": "^2.1.11",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-styled-components": "^2.3.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "jest-styled-components": "^7.0.0",
    "jsdom": "^30.1.3",
    "npm-check": "^6.0.1",
    "npm-run-all": "^4.1.5",
    "storybook": "^10.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "vite build",
    "build-docker": "docker build -t deciphernow/gm-fabric-dashboard -f docker-prod/Dockerfile .",
    "build-storybook": "storybook build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p e2e",
    "mock-sds": "node json-mock/discovery-service/sds.js",
    "preview": "vite preview",
    "start": "npm-run-all --print-label --parallel start-ui mock-sds",
    "start-ui": "vite",
    "storybook": "storybook dev -p 6006",
    "test": "cross-env TZ=America/New_York vitest",
    "test:coverage": "cross-env TZ=America/New_York vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "update-deps": "npm-check . --skip-unused -u",
    "update-snapshots": "cross-env CI=true TZ=America/New_York vitest run --update"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 ChromeAndroid versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "Firefox ESR"
  ],
  "homepage": "./"
}
